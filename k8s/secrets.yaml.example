apiVersion: v1
kind: Secret
metadata:
  name: cominow-secrets
  namespace: cominow
type: Opaque
stringData:
  # Database
  AUTH_DATABASE_URL: "mongodb+srv://user:password@host/database"
  PRODUCTS_DATABASE_URL: "postgresql://user:password@host:5432/database?schema=products"
  ORDERS_DATABASE_URL: "postgresql://user:password@host:5432/database?schema=orders"
  PAYMENTS_DATABASE_URL: "postgresql://user:password@host:5432/database?schema=payments"
  CUSTOMIZATION_DATABASE_URL: "postgresql://user:password@host:5432/database?schema=customization"

  # Auth & Security
  JWT_SECRET: "your-super-secret-jwt-key-here"

  # Mercado Pago
  MERCADO_PAGO_ACCESS_TOKEN: "your-mercado-pago-access-token"
  MERCADO_PAGO_WEBHOOK_SECRET: "your-mercado-pago-webhook-secret"

  # Cloudinary
  CLOUDINARY_CLOUD_NAME: "your-cloud-name"
  CLOUDINARY_API_KEY: "your-api-key"
  CLOUDINARY_API_SECRET: "your-api-secret"
